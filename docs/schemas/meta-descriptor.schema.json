{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webgme.org/schemas/meta-descriptor/v1.json",
  "title": "MetaDescriptor",
  "description": "Compact metamodel for GMEBot. One **main container** concept (domain name, e.g. StateMachine — not Diagram) has contains listing every instantiable type including connection concepts. Each link type is a concept ({} = FCO only) plus relationships.{Name} = { from, to }. Cardinality only in contains values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "concepts"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "concepts": {
      "type": "object",
      "description": "META types keyed by concept name (e.g. concepts.State). Names must be plain identifiers — no *, :, or cardinality suffixes.",
      "propertyNames": { "$ref": "#/$defs/conceptName" },
      "additionalProperties": { "$ref": "#/$defs/conceptBody" }
    },
    "relationships": {
      "type": "object",
      "description": "Link/edge types keyed by connection concept name. Each value sets src/dst on that concept in WebGME.",
      "propertyNames": { "$ref": "#/$defs/conceptName" },
      "additionalProperties": { "$ref": "#/$defs/relationshipBody" }
    }
  },
  "$defs": {
    "conceptName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "description": "Concept name (identifier). Not FCO, not State:* or paths."
    },
    "cardinality": {
      "type": "string",
      "description": "Containment cardinality for the child type.",
      "enum": ["*", "+", "?", "1", "0..1"]
    },
    "attributeType": {
      "type": "string",
      "enum": ["string", "float", "enum", "bool", "asset", "integer"]
    },
    "attributeMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/attributeType" },
        "hidden": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "password": { "type": "boolean" },
        "multiline": { "type": "string", "minLength": 1 },
        "values": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "regex": { "type": "string" },
        "default": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
          "then": { "required": ["values"] }
        }
      ]
    },
    "attributeDef": {
      "oneOf": [
        { "$ref": "#/$defs/attributeType" },
        { "$ref": "#/$defs/attributeMeta" }
      ]
    },
    "typeRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "description": "Target concept name (no cardinality)."
    },
    "typeRefOrList": {
      "oneOf": [
        { "$ref": "#/$defs/typeRef" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/typeRef" }
        }
      ]
    },
    "containsMap": {
      "type": "object",
      "description": "On the **main container** only: child concept name → cardinality. List node types AND connection types (e.g. State, Transition) so instances can be created.",
      "propertyNames": { "$ref": "#/$defs/conceptName" },
      "additionalProperties": { "$ref": "#/$defs/cardinality" }
    },
    "relationshipBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "description": "Wires src/dst on the connection concept (key must match concepts.{same name}, usually {}).",
      "properties": {
        "from": { "$ref": "#/$defs/typeRefOrList" },
        "to": { "$ref": "#/$defs/typeRefOrList" }
      }
    },
    "conceptBody": {
      "type": "object",
      "additionalProperties": false,
      "description": "Empty {} = concept extending FCO only (typical for State, Transition). Omit extends for FCO.",
      "properties": {
        "extends": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "Base concept name. Omit when extending FCO."
        },
        "contains": { "$ref": "#/$defs/containsMap" },
        "pointers": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/typeRefOrList" },
          "description": "Non-connection pointers (not src/dst — use relationships)."
        },
        "sets": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/containsMap" },
          "description": "Set name → member type(s) with cardinality."
        },
        "attributes": {
          "type": "object",
          "description": "Attributes defined on this concept only. Do not include name — it is inherited from FCO.",
          "propertyNames": {
            "not": { "enum": ["name"] }
          },
          "additionalProperties": { "$ref": "#/$defs/attributeDef" }
        }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "concepts": {
        "StateMachine": {
          "contains": { "State": "*", "InitialState": "1", "Transition": "*" }
        },
        "State": {
          "attributes": {
            "priority": { "type": "integer", "min": 0, "max": 10, "default": 0 }
          }
        },
        "InitialState": {},
        "Transition": {}
      },
      "relationships": {
        "Transition": { "from": "State", "to": "State" }
      }
    }
  ]
}
