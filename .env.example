# Copy to `.env` (optional). `npm start` uses: node --env-file-if-exists=.env app.js
#
# WebGME: NODE_ENV selects config/config.<NODE_ENV>.js — see config/README.md.
# Use the env template whose name matches that profile, e.g.:
#   .env.jarvis.example  ↔  config/config.jarvis.js
#
# Local dev: omit `.env` (uses config.default.js) or uncomment below.

# NODE_ENV=default

# --- cback / GMEBot (see packages/cback/src/llmAdapter.ts) ---
# LLM_BACKEND=openai
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# Qwen 3.5 9B + tools; 64k context (recommended on M1 Max / 64GB RAM):
#   ./config/ollama/setup-macos.sh
#   (creates qwen3.5:9b-64k and sets OLLAMA_* via launchctl; restart Ollama after)
# LLM_MODEL=qwen3.5:9b-64k
# LLM_API_KEY=
# LLM_HTTP_DEBUG=1
# Single LLM HTTP request timeout (ms). Default 120000 (2 min). Use 0 to disable.
# CBACK_LLM_REQUEST_TIMEOUT_MS=300000

# LLM_BACKEND=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=
# LLM_ANTHROPIC_VERSION=
