# Copy this file to .env and set the values you need.
# .env is gitignored; never commit real API keys.
# Use lines WITHOUT a leading # so they take effect (e.g. LLM_PROVIDER=groq not # LLM_PROVIDER=groq).

# LLM provider: ollama | groq | openai | anthropic (default: ollama)
# LLM_PROVIDER=groq

# Groq (free tier) - get key at https://console.groq.com
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=llama-3.1-8b-instant

# OpenAI - get key at https://platform.openai.com
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# Anthropic - get key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# GMEBot/cback: max tool-call rounds per user message (default: 5, range 1–50)
# CBACK_MAX_TOOL_ROUNDS=5
