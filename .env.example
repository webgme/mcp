# Copy to `.env` (optional). `npm start` uses: node --env-file-if-exists=.env app.js
#
# WebGME: NODE_ENV selects config/config.<NODE_ENV>.js — see config/README.md.
# Local dev: omit `.env` (uses config.default.js) or set NODE_ENV=default.

NODE_ENV=jarvis

# --- cback / GMEBot (OpenAI-compatible) ---
LLM_BACKEND=openai
LLM_BASE_URL=https://jarvis.kecso.org/v1
LLM_MODEL=engineering-gpt
# LLM_API_KEY=...   # if the server requires a bearer token

# LLM_BACKEND=anthropic    # optional alternative
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=
# LLM_ANTHROPIC_VERSION=
